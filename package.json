{
  "name": "lab6-ci-cd",
  "version": "1.0.0",
  "description": "Лабораторная работа №6: CI/CD для автоматизированных тестов",
  "main": "server.js",
 "scripts": {
  "start": "node server.js",
  "test:unit": "jest",
  "test:api": "cucumber-js",
  "test:api:ci": "start-server-and-test start http://127.0.0.1:3000 \"npm run test:api\"",
  "test:ui": "playwright test",
  "test:ui:ci": "start-server-and-test start http://127.0.0.1:3000 \"npm run test:ui\"",
  "allure:generate": "allure generate allure-results --clean -o allure-report",
  "allure:open": "allure open allure-report"
},
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.59.0",
    "@types/node": "^25.5.0",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.4.2",
    "allure-jest": "^3.4.2",
    "allure-playwright": "^3.4.2",
    "jest": "^29.7.0",
    "start-server-and-test": "^2.1.2"
  }
}
